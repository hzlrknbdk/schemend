{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!apps/landing/src/components/ui",
			"!apps/landing/src/routeTree.gen.ts",
			"!apps/dashboard/src/components/ui",
			"!apps/dashboard/src/routeTree.gen.ts",
			"!packages/ui/src/vendor"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/landing/src/**",
				"apps/dashboard/src/**",
				"packages/ui/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "error",
						"useConsistentTypeDefinitions": "error",
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"filenameCases": ["kebab-case"]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/landing/src/routes/**",
				"apps/dashboard/src/routes/**"
			],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/dashboard/src/features/overview/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/features/**",
											"!@/features/overview/**",
											"@/routes/**"
										]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/dashboard/src/features/apis/**"],
			"linter": {
