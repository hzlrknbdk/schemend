{
  "id": "field-to-object",
  "description": "orders: totalPrice replaced by total { amount, currency }",
  "real": false,
  "source": "schemend-demo",
  "ref": "26b3d87",
  "providerSchema": "services/orders/openapi.json",
  "schemaBefore": "schema.before.json",
  "schemaAfter": "schema.after.json",
  "consumers": {
    "apps/checkout-web": {
      "expected": "fixed",
      "setup": [
        "pnpm install --frozen-lockfile",
        "pnpm generate:api",
        "pnpm exec next typegen"
      ],
      "checks": ["pnpm typecheck", "pnpm test"],
      "mustNotContain": [".totalPrice"]
    },
    "services/invoice": {
      "expected": "fixed",
      "setup": ["mvn -q -B generate-sources"],
      "checks": ["mvn -q -B test-compile", "mvn -q -B test"],
      "mustNotContain": [".getTotalPrice()"]
    },
    "services/notification": {
      "expected": "fixed",
      "flagContains": "currency",
      "setup": [
        "dotnet build src/Notification/Notification.csproj --no-restore -t:GenerateOrdersClient"
      ],
      "checks": [
        "dotnet build tests/Notification.Tests/Notification.Tests.csproj --no-restore",
        "dotnet test tests/Notification.Tests/Notification.Tests.csproj --no-restore"
      ],
      "mustNotContain": [".TotalPrice"]
    }
  }
}
